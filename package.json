{
  "name": "@gripm/playbook",
  "version": "2.7.0",
  "description": "Autonomous multi-agent agile framework for modern software development with dynamic modes, decoupled releases, and sub-agent orchestration.",
  "type": "module",
  "main": "./scripts/sync-playbook.mjs",
  "bin": {
    "playbook": "scripts/sync-playbook.mjs",
    "gripm-playbook": "scripts/sync-playbook.mjs",
    "gate-qa": "scripts/gate-qa.mjs",
    "audit-ux": "scripts/audit-ux-code.cjs",
    "check-loc": "scripts/check-loc.mjs",
    "validate-commit": "scripts/validate-commit-msg.mjs"
  },
  "exports": {
    ".": "./scripts/sync-playbook.mjs",
    "./audit": "./scripts/audit-ux-code.cjs",
    "./gate": "./scripts/gate-qa.mjs",
    "./check-loc": "./scripts/check-loc.mjs",
    "./validate-commit": "./scripts/validate-commit-msg.mjs",
    "./init": "./scripts/init.mjs",
    "./package.json": "./package.json",
    "./scripts/*": "./scripts/*"
  },
  "scripts": {
    "sync": "node scripts/sync-playbook.mjs",
    "init": "node scripts/init.mjs",
    "playbook:sync": "node scripts/sync-playbook.mjs",
    "stacks": "node scripts/sync-playbook.mjs --list-stacks",
    "audit:ux": "node scripts/audit-ux-code.cjs",
    "audit:ux:strict": "node scripts/audit-ux-code.cjs --strict",
    "audit:ux:baseline": "node scripts/audit-ux-code.cjs --update-baseline",
    "rules": "node scripts/audit-ux-code.cjs --list-rules",
    "validate": "node scripts/validate-repo.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:loc": "node scripts/check-loc.mjs",
    "check:loc:strict": "node scripts/check-loc.mjs --strict",
    "gate:qa": "node scripts/gate-qa.mjs",
    "gate:review": "node scripts/gate-review-items.mjs",
    "validate:commit": "node scripts/validate-commit-msg.mjs",
    "check:all": "npm run validate && npm run check:loc && npm test"
  },
  "keywords": [
    "agentic",
    "agile",
    "ai",
    "llm",
    "multi-agent",
    "framework",
    "playbook",
    "skills",
    "antigravity",
    "cursor",
    "claude-code",
    "copilot"
  ],
  "author": "Pablo Javier Rodríguez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablojavierrodriguez/gripm-playbook.git"
  },
  "homepage": "https://github.com/pablojavierrodriguez/gripm-playbook#readme",
  "bugs": {
    "url": "https://github.com/pablojavierrodriguez/gripm-playbook/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    ".agents",
    ".playbook-manifest.json",
    "docs",
    "scripts",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
