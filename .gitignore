# Dependencies
node_modules/
.pnp
.pnp.js

# Build and outputs
dist/
build/
out/
.next/
coverage/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
.gripm/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playbook sync artifacts
# Backups are local recovery copies of overwritten framework files.
# .playbook-lock.json is NOT ignored on purpose: in a consuming project it is
# the audit trail that tells the sync which files carry local modifications.
.playbook-backups/
*.tgz

# Auditor scratch
# Neither .uxaudit.json nor audit-ux-baseline.json is ignored on purpose: in a
# consuming project they are, respectively, the agreed opt-out configuration and
# the agreed record of which observations were reviewed and accepted. Both belong
# in version control.
*.baseline.json.tmp
